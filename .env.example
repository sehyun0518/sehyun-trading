# ── 운영 모드 ──────────────────────────────────────────────────────────────
# paper=모의투자 | real=실전투자
KIS_MODE=paper

# ── KIS Developers API — 모의투자 ──────────────────────────────────────────
# https://apiportal.koreainvestment.com 에서 모의투자 앱 등록 후 발급
# 모의투자 전용 앱키 (실전투자 앱키와 별개로 발급 필요)
KIS_PAPER_APP_KEY=your_paper_app_key
KIS_PAPER_APP_SECRET=your_paper_app_secret
KIS_PAPER_ACCOUNT_NO=12345678-01          # 모의투자 계좌번호

# ── KIS Developers API — 실전투자 ──────────────────────────────────────────
# https://apiportal.koreainvestment.com 에서 실전투자 앱 등록 후 발급
KIS_REAL_APP_KEY=your_real_app_key
KIS_REAL_APP_SECRET=your_real_app_secret
KIS_REAL_ACCOUNT_NO=87654321-01           # 실전투자 계좌번호

# ── Claude API ──────────────────────────────────────────────────────────────
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# ── pykrx — KRX 데이터 포털 ────────────────────────────────────────────────
# https://data.krx.co.kr 무료 회원가입 후 사용
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# ── 데이터베이스 ────────────────────────────────────────────────────────────
# PostgreSQL URL (EC2 배포 시 설정; 없으면 SQLite 사용)
# DATABASE_URL=postgresql://trading:trading_pw@localhost:5432/trading_db

# ── 포트폴리오 ──────────────────────────────────────────────────────────────
# 초기 현금 (원), 기본값 10,000,000
# PORTFOLIO_CASH=10000000

# ── 보안 ────────────────────────────────────────────────────────────────────
# 관리자 로그인 패스워드 (프론트엔드 로그인 화면에서 사용)
ADMIN_PASSWORD=your_strong_password

# JWT 서명 비밀키 (랜덤 문자열, 최소 32자)
# 생성 예: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_jwt_secret

# Fernet 암호화 키 (KIS 자격증명 DB 저장용)
# 생성 예: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key

# CORS 허용 도메인 (쉼표 구분, * = 전체 허용)
CORS_ORIGINS=https://your-vercel-domain.vercel.app,https://sehyun0518.dev

# ── 선택: Notion 연동 ───────────────────────────────────────────────────────
# NOTION_TOKEN=secret_...
# NOTION_DATABASE_ID=...
